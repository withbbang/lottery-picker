# deploy/compose.yml 이 읽는 키 목록. 실제 값은 서버의 deploy/.env 에만 둔다 (Git 제외).
# 비밀번호는 영문·숫자 위주로 (따옴표, $, 공백 금지).

# MySQL. 처음 볼륨을 만들 때만 적용된다. 이후 바꾸려면 README의 비밀번호 변경 절차를 따른다.
MYSQL_ROOT_PASSWORD=
# 앱 계정. root 는 쓸 수 없다.
DB_USERNAME=lottery
DB_PASSWORD=
# 생략하면 jdbc:mysql://mysql:3306/lottery
DB_URL=

# 비워 두고 첫 등록(README "OTP 첫 등록")에서 채운다.
TOTP_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 로컬 확인용으로만 false. 운영은 비워 둔다 (기본 true).
SCHEDULING_ENABLED=
